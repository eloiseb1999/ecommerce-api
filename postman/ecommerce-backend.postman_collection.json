{
  "info": {
    "name": "E-commerce Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Registrar usuario",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"maria@email.com\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login (usuario comum)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"maria@email.com\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login (admin seed)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@ecommerce.com\",\n  \"password\": \"admin123\"\n}"
        }
      }
    },
    {
      "name": "Categorias - Listar",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/categories" }
    },
    {
      "name": "Produtos - Criar (admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Notebook Gamer\",\n  \"description\": \"16GB RAM, RTX 4060\",\n  \"price\": 6499.90,\n  \"stockQuantity\": 15,\n  \"categoryId\": \"{{categoryId}}\"\n}"
        }
      }
    },
    {
      "name": "Produtos - Listar",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products?page=0&size=10" }
    },
    {
      "name": "Carrinho - Adicionar item",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/cart/items",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
        }
      }
    },
    {
      "name": "Carrinho - Ver carrinho",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/cart"
      }
    },
    {
      "name": "Pedidos - Checkout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/orders/checkout",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shippingAddress\": \"Rua das Flores, 123 - Sao Paulo/SP\"\n}"
        }
      }
    },
    {
      "name": "Pedidos - Meus pedidos",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "Admin - Listar todos os pedidos",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/admin/orders"
      }
    }
  ]
}
